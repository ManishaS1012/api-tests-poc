{
  "info": {
    "_postman_id": "abac787e-7af8-4324-bbc7-7b37d4ed6943",
    "name": "REST_API_test",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "17601637"
  },
  "item": [
    {
      "name": "UAT/Get Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// ═══════════════════════════════════════════════════════════════",
              "//  Get Token API – Test Suite",
              "//  Positive Tests : TC-P-01 … TC-P-12",
              "//  Negative Tests : TC-N-01 … TC-N-09",
              "// ═══════════════════════════════════════════════════════════════",
              "",
              "const res = pm.response.json();",
              "const req = (() => { try { return JSON.parse(pm.request.body.raw); } catch(e) { return {}; } })();",
              "",
              "// ── Save access_token to environment variable ──────────────────",
              "if (res && res.Status === true && res.access_token) {",
              "    pm.environment.set(\"auth\", \"Bearer \" + res.access_token);",
              "    console.log(\"✅ access_token saved to environment variable 'auth'\");",
              "} else {",
              "    console.warn(\"⚠️ Token not saved – Status was false or access_token missing\");",
              "}",
              "// ──────────────────────────────────────────────────────────────",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION A – HTTP & Response Basics",
              "// ───────────────────────────────────────────────────────────────",
              "",
              "pm.test(\"TC-P-01 | HTTP status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"TC-P-02 | Response time is under 10000 ms\", () => {",
              "    pm.expect(pm.response.responseTime).to.be.below(10000);",
              "});",
              "",
              "pm.test(\"TC-P-03 | Content-Type is application/json\", () => {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"TC-P-04 | Response body is valid JSON\", () => {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION B – Top-Level Response Fields",
              "// ───────────────────────────────────────────────────────────────",
              "",
              "pm.test(\"TC-P-05 | Status field is true\", () => {",
              "    pm.expect(res.Status).to.be.true;",
              "});",
              "",
              "pm.test(\"TC-P-06 | StatusCode is 200\", () => {",
              "    pm.expect(res.StatusCode).to.eql(200);",
              "});",
              "",
              "pm.test(\"TC-P-07 | access_token is a non-empty string\", () => {",
              "    pm.expect(res.access_token).to.be.a(\"string\").and.have.length.above(0);",
              "});",
              "",
              "pm.test(\"TC-P-08 | access_token is saved to environment variable auth\", () => {",
              "    const saved = pm.environment.get(\"auth\");",
              "    pm.expect(saved).to.be.a(\"string\").and.match(/^Bearer\\s.+/);",
              "});",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION C – Response Schema Validation",
              "// ───────────────────────────────────────────────────────────────",
              "",
              "pm.test(\"TC-P-09 | Response schema is valid (GetTokenResponse)\", () => {",
              "    const schema = {",
              "        type: \"object\",",
              "        required: [\"StatusCode\", \"Status\"],",
              "        properties: {",
              "            StatusCode:    { type: \"number\" },",
              "            Status:        { type: \"boolean\" },",
              "            Message:       { type: [\"string\", \"null\"] },",
              "            access_token:  { type: [\"string\", \"null\"] },",
              "            id_token:      { type: [\"string\", \"null\"] },",
              "            scope:         { type: [\"string\", \"null\"] }",
              "        },",
              "        additionalProperties: true",
              "    };",
              "    pm.response.to.have.jsonSchema(schema);",
              "});",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION D – Request Body Schema Validation",
              "// ───────────────────────────────────────────────────────────────",
              "",
              "pm.test(\"TC-P-10 | Request body schema is valid (GetTokenRequest)\", () => {",
              "    const schema = {",
              "        type: \"object\",",
              "        properties: {",
              "            username: { type: [\"string\", \"null\"] },",
              "            password: { type: [\"string\", \"null\"] }",
              "        },",
              "        additionalProperties: false",
              "    };",
              "    pm.expect(tv4.validate(req, schema)).to.be.true;",
              "});",
              "",
              "pm.test(\"TC-P-11 | Request username is a non-empty string\", () => {",
              "    pm.expect(req.username).to.be.a(\"string\").and.have.length.above(0);",
              "});",
              "",
              "pm.test(\"TC-P-12 | Request password is a non-empty string\", () => {",
              "    pm.expect(req.password).to.be.a(\"string\").and.have.length.above(0);",
              "});",
              "",
              "// ═══════════════════════════════════════════════════════════════",
              "//  NEGATIVE TEST CASES",
              "// ═══════════════════════════════════════════════════════════════",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION E – HTTP Error Guards",
              "// ───────────────────────────────────────────────────────────────",
              "",
              "pm.test(\"TC-N-01 | Response is not 401 Unauthorized\", () => {",
              "    pm.expect(pm.response.code).to.not.eql(401);",
              "});",
              "",
              "pm.test(\"TC-N-02 | Response is not 500 Internal Server Error\", () => {",
              "    pm.expect(pm.response.code).to.not.eql(500);",
              "});",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION F – Credential Validation Guards",
              "// ───────────────────────────────────────────────────────────────",
              "",
              "pm.test(\"TC-N-03 | Wrong credentials – Status must be false (guard check)\", () => {",
              "    // Validates that if credentials were wrong, Status would not be true",
              "    // Since this runs with valid credentials, Status must be true — confirming correct creds are used",
              "    if (req.username !== \"uafrica\" || req.password !== \"uafricauat123\") {",
              "        pm.expect(res.Status).to.be.false;",
              "    } else {",
              "        pm.expect(res.Status).to.be.true;",
              "    }",
              "});",
              "",
              "pm.test(\"TC-N-04 | Missing username – access_token must not be returned\", () => {",
              "    // Guard: if username is missing or empty, no token should be issued",
              "    if (!req.username || req.username.trim() === \"\") {",
              "        pm.expect(res.access_token).to.be.null;",
              "    }",
              "});",
              "",
              "pm.test(\"TC-N-05 | Missing password – access_token must not be returned\", () => {",
              "    // Guard: if password is missing or empty, no token should be issued",
              "    if (!req.password || req.password.trim() === \"\") {",
              "        pm.expect(res.access_token).to.be.null;",
              "    }",
              "});",
              "",
              "pm.test(\"TC-N-06 | Null username – access_token must not be returned\", () => {",
              "    if (req.username === null) {",
              "        pm.expect(res.access_token).to.be.null;",
              "    }",
              "});",
              "",
              "pm.test(\"TC-N-07 | Null password – access_token must not be returned\", () => {",
              "    if (req.password === null) {",
              "        pm.expect(res.access_token).to.be.null;",
              "    }",
              "});",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION G – Response Consistency Guards",
              "// ───────────────────────────────────────────────────────────────",
              "",
              "pm.test(\"TC-N-08 | StatusCode and Status field must be consistent\", () => {",
              "    // StatusCode 200 must align with Status: true; non-200 must align with Status: false",
              "    if (res.StatusCode === 200) {",
              "        pm.expect(res.Status).to.be.true;",
              "    } else {",
              "        pm.expect(res.Status).to.be.false;",
              "    }",
              "});",
              "",
              "pm.test(\"TC-N-09 | When Status is false – access_token must be null or absent\", () => {",
              "    if (res.Status === false) {",
              "        const token = res.access_token;",
              "        pm.expect(token === null || token === undefined || token === \"\").to.be.true;",
              "    }",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"username\": \"uafrica\",\r\n  \"password\": \"uafricauat123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BaseURL}}/Integration/GetToken",
          "host": [
            "{{BaseURL}}"
          ],
          "path": [
            "Integration",
            "GetToken"
          ]
        }
      },
      "response": []
    },
    {
      "name": "UAT/ConsignmentUpload",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';\r",
              "const digits  = '0123456789';\r",
              "\r",
              "const rndL = (n) => Array.from({length: n}, () => letters[Math.floor(Math.random() * letters.length)]).join('');\r",
              "const rndD = (n) => Array.from({length: n}, () => digits[Math.floor(Math.random() * digits.length)]).join('');\r",
              "\r",
              "// Pattern: UAR + 3 letters + 2 digits  →  e.g. UARNRY24\r",
              "const consignmentID = \"UAR\" + rndL(3) + rndD(2);\r",
              "pm.environment.set(\"ConsignmentID\", consignmentID);\r",
              "\r",
              "console.log(\"Generated ConsignmentID:\", consignmentID);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// ═══════════════════════════════════════════════════════════════",
              "//  ConsignmentUpload API – Test Suite",
              "//  Positive Tests : TC-P-01 … TC-P-35",
              "//  Negative Tests : TC-N-01 … TC-N-25",
              "// ═══════════════════════════════════════════════════════════════",
              "",
              "const res  = pm.response.json();",
              "const req  = (() => { try { return JSON.parse(pm.request.body.raw); } catch(e) { return {}; } })();",
              "const isOk = res.Status === true;",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION A – HTTP & Response Basics",
              "// ───────────────────────────────────────────────────────────────",
              "",
              "pm.test(\"TC-P-01 | HTTP status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"TC-P-02 | Response time is under 3000 ms\", () => {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "",
              "pm.test(\"TC-P-03 | Content-Type is application/json\", () => {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"TC-P-04 | Response body is valid JSON\", () => {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION B – Top-Level Response Fields",
              "// ───────────────────────────────────────────────────────────────",
              "",
              "pm.test(\"TC-P-05 | Status field is true\", () => {",
              "    pm.expect(res.Status).to.be.true;",
              "});",
              "",
              "pm.test(\"TC-P-06 | Message is 'Consignment Saved Successfully'\", () => {",
              "    pm.expect(res.Message).to.eql(\"Consignment Saved Successfully\");",
              "});",
              "",
              "pm.test(\"TC-P-07 | Errors array exists and is not empty\", () => {",
              "    pm.expect(res.Errors).to.be.an(\"array\").that.is.not.empty;",
              "});",
              "",
              "pm.test(\"TC-P-08 | Errors[0].StatusCode is '200'\", () => {",
              "    pm.expect(res.Errors[0].StatusCode).to.eql(\"200\");",
              "});",
              "",
              "pm.test(\"TC-P-09 | Errors[0].ErrorMessage is empty string on success\", () => {",
              "    pm.expect(res.Errors[0].ErrorMessage).to.eql(\"\");",
              "});",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION C – ConsignmentDetail",
              "// ───────────────────────────────────────────────────────────────",
              "",
              "pm.test(\"TC-P-10 | ConsignmentDetail exists with required fields\", () => {",
              "    pm.expect(res.ConsignmentDetail).to.be.an(\"object\");",
              "    pm.expect(res.ConsignmentDetail).to.have.all.keys(\"ConsignmentRecordID\", \"ConsignmentID\");",
              "});",
              "",
              "pm.test(\"TC-P-11 | ConsignmentRecordID is a non-zero numeric string\", () => {",
              "    const id = res.ConsignmentDetail.ConsignmentRecordID;",
              "    pm.expect(id).to.be.a(\"string\").and.match(/^\\d+$/);",
              "    pm.expect(parseInt(id, 10)).to.be.above(0);",
              "});",
              "",
              "pm.test(\"TC-P-12 | ConsignmentID matches UAR pattern (UAR + 3 letters + 2 digits)\", () => {",
              "    pm.expect(res.ConsignmentDetail.ConsignmentID).to.match(/^UAR[A-Z]{3}\\d{2}$/);",
              "});",
              "",
              "pm.test(\"TC-P-13 | ConsignmentID in response matches the sent ConsignmentID\", () => {",
              "    const sent = pm.environment.get(\"ConsignmentID\");",
              "    pm.expect(res.ConsignmentDetail.ConsignmentID).to.eql(sent);",
              "});",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION D – ConsignmentLabelDetails",
              "// ───────────────────────────────────────────────────────────────",
              "",
              "pm.test(\"TC-P-14 | ConsignmentLabelDetails exists with required fields\", () => {",
              "    pm.expect(res.ConsignmentLabelDetails).to.be.an(\"object\");",
              "    [\"ConsignmentID\", \"ReceiverHubID\", \"ServiceTypeCode\", \"ShipperReference\", \"SectorCode\"].forEach(f => {",
              "        pm.expect(res.ConsignmentLabelDetails).to.have.property(f);",
              "    });",
              "});",
              "",
              "pm.test(\"TC-P-15 | ConsignmentLabelDetails.ConsignmentID matches response ConsignmentID\", () => {",
              "    pm.expect(res.ConsignmentLabelDetails.ConsignmentID).to.eql(res.ConsignmentDetail.ConsignmentID);",
              "});",
              "",
              "pm.test(\"TC-P-16 | ServiceTypeCode is a non-empty string\", () => {",
              "    pm.expect(res.ConsignmentLabelDetails.ServiceTypeCode).to.be.a(\"string\").and.have.length.above(0);",
              "});",
              "",
              "pm.test(\"TC-P-17 | ReceiverHubID is a non-empty string\", () => {",
              "    pm.expect(res.ConsignmentLabelDetails.ReceiverHubID).to.be.a(\"string\").and.have.length.above(0);",
              "});",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION E – ParcelDetails",
              "// ───────────────────────────────────────────────────────────────",
              "",
              "pm.test(\"TC-P-18 | ParcelDetails is a non-empty array\", () => {",
              "    pm.expect(res.ParcelDetails).to.be.an(\"array\").that.is.not.empty;",
              "});",
              "",
              "pm.test(\"TC-P-19 | ParcelDetails count matches NoOfParcels in request\", () => {",
              "    if (req.NoOfParcels !== undefined) {",
              "        pm.expect(res.ParcelDetails.length).to.eql(req.NoOfParcels);",
              "    }",
              "});",
              "",
              "pm.test(\"TC-P-20 | Each ParcelDetail has ConsignmentRecordID, TrackingNo, ParcelNumber\", () => {",
              "    res.ParcelDetails.forEach((p, i) => {",
              "        pm.expect(p, `ParcelDetails[${i}]`).to.have.all.keys(\"ConsignmentRecordID\", \"TrackingNo\", \"ParcelNumber\");",
              "    });",
              "});",
              "",
              "pm.test(\"TC-P-21 | TrackingNo follows pattern ConsignmentID.NNN\", () => {",
              "    const cid = res.ConsignmentDetail.ConsignmentID;",
              "    res.ParcelDetails.forEach((p, i) => {",
              "        pm.expect(p.TrackingNo, `ParcelDetails[${i}].TrackingNo`).to.match(new RegExp(`^${cid}\\\\.\\\\d{3}$`));",
              "    });",
              "});",
              "",
              "pm.test(\"TC-P-22 | ParcelNumber is a positive integer\", () => {",
              "    res.ParcelDetails.forEach((p, i) => {",
              "        pm.expect(p.ParcelNumber, `ParcelDetails[${i}].ParcelNumber`).to.be.a(\"number\").and.be.above(0);",
              "    });",
              "});",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION F – LabelDetails",
              "// ───────────────────────────────────────────────────────────────",
              "",
              "pm.test(\"TC-P-23 | LabelDetails is a non-empty array\", () => {",
              "    pm.expect(res.LabelDetails).to.be.an(\"array\").that.is.not.empty;",
              "});",
              "",
              "pm.test(\"TC-P-24 | Each LabelDetail has ParcelIdentifier and LabelData\", () => {",
              "    res.LabelDetails.forEach((l, i) => {",
              "        pm.expect(l, `LabelDetails[${i}]`).to.have.property(\"ParcelIdentifier\");",
              "        pm.expect(l, `LabelDetails[${i}]`).to.have.property(\"LabelData\");",
              "    });",
              "});",
              "",
              "pm.test(\"TC-P-25 | LabelData is a non-empty string (base64 PDF)\", () => {",
              "    res.LabelDetails.forEach((l, i) => {",
              "        pm.expect(l.LabelData, `LabelDetails[${i}].LabelData`).to.be.a(\"string\").and.have.length.above(0);",
              "    });",
              "});",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION G – Schema Validation (ConsignmentUploadRequest)",
              "// ───────────────────────────────────────────────────────────────",
              "",
              "pm.test(\"TC-P-26 | Response schema is valid (top-level fields)\", () => {",
              "    const schema = {",
              "        type: \"object\",",
              "        required: [\"Status\", \"Message\", \"Errors\", \"ConsignmentDetail\", \"ConsignmentLabelDetails\", \"ParcelDetails\", \"LabelDetails\"],",
              "        properties: {",
              "            Status:                  { type: \"boolean\" },",
              "            Message:                 { type: \"string\" },",
              "            Errors:                  { type: \"array\" },",
              "            ConsignmentDetail:       { type: \"object\" },",
              "            ConsignmentLabelDetails: { type: \"object\" },",
              "            ParcelDetails:           { type: \"array\" },",
              "            LabelDetails:            { type: \"array\" }",
              "        },",
              "        additionalProperties: true",
              "    };",
              "    pm.response.to.have.jsonSchema(schema);",
              "});",
              "",
              "pm.test(\"TC-P-27 | ConsignmentDetail schema is valid\", () => {",
              "    const schema = {",
              "        type: \"object\",",
              "        required: [\"ConsignmentRecordID\", \"ConsignmentID\"],",
              "        properties: {",
              "            ConsignmentRecordID: { type: \"string\" },",
              "            ConsignmentID:       { type: \"string\" }",
              "        }",
              "    };",
              "    pm.expect(res.ConsignmentDetail).to.have.jsonSchema(schema);",
              "});",
              "",
              "pm.test(\"TC-P-28 | ConsignmentLabelDetails schema is valid\", () => {",
              "    const schema = {",
              "        type: \"object\",",
              "        required: [\"ConsignmentID\", \"ReceiverHubID\", \"ServiceTypeCode\", \"ShipperReference\", \"SectorCode\"],",
              "        properties: {",
              "            ConsignmentID:    { type: \"string\" },",
              "            ReceiverHubID:    { type: \"string\" },",
              "            ServiceTypeCode:  { type: \"string\" },",
              "            ShipperReference: { type: \"string\" },",
              "            SectorCode:       { type: \"string\" },",
              "            SortCode:         { type: [\"string\", \"null\"] },",
              "            PickByLight:      { type: [\"string\", \"null\"] }",
              "        }",
              "    };",
              "    pm.expect(res.ConsignmentLabelDetails).to.have.jsonSchema(schema);",
              "});",
              "",
              "pm.test(\"TC-P-29 | ParcelDetails items schema is valid\", () => {",
              "    const schema = {",
              "        type: \"array\",",
              "        items: {",
              "            type: \"object\",",
              "            required: [\"ConsignmentRecordID\", \"TrackingNo\", \"ParcelNumber\"],",
              "            properties: {",
              "                ConsignmentRecordID: { type: \"string\" },",
              "                TrackingNo:          { type: \"string\" },",
              "                ParcelNumber:        { type: \"number\" }",
              "            }",
              "        }",
              "    };",
              "    pm.expect(res.ParcelDetails).to.have.jsonSchema(schema);",
              "});",
              "",
              "pm.test(\"TC-P-30 | LabelDetails items schema is valid\", () => {",
              "    const schema = {",
              "        type: \"array\",",
              "        items: {",
              "            type: \"object\",",
              "            required: [\"ParcelIdentifier\", \"LabelData\"],",
              "            properties: {",
              "                ParcelIdentifier: { type: \"string\" },",
              "                LabelData:        { type: \"string\" }",
              "            }",
              "        }",
              "    };",
              "    pm.expect(res.LabelDetails).to.have.jsonSchema(schema);",
              "});",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION H – Environment Variable Persistence",
              "// ───────────────────────────────────────────────────────────────",
              "",
              "pm.test(\"TC-P-31 | Environment variable ConsignmentID is set\", () => {",
              "    pm.expect(pm.environment.get(\"ConsignmentID\")).to.be.a(\"string\").and.have.length.above(0);",
              "});",
              "",
              "pm.test(\"TC-P-32 | savedConsignmentID is saved to environment\", () => {",
              "    if (isOk) {",
              "        pm.environment.set(\"savedConsignmentID\", res.ConsignmentDetail.ConsignmentID);",
              "    }",
              "    pm.expect(pm.environment.get(\"savedConsignmentID\")).to.be.a(\"string\").and.have.length.above(0);",
              "});",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION I – Request Body Field Validation (Positive)",
              "// ───────────────────────────────────────────────────────────────",
              "",
              "pm.test(\"TC-P-33 | Request BilledTo is a non-empty string\", () => {",
              "    pm.expect(req.BilledTo).to.be.a(\"string\").and.have.length.above(0);",
              "});",
              "",
              "pm.test(\"TC-P-34 | Request ServiceTypeCode is a non-empty string\", () => {",
              "    pm.expect(req.ServiceTypeCode).to.be.a(\"string\").and.have.length.above(0);",
              "});",
              "",
              "pm.test(\"TC-P-35 | Request NoOfParcels is a positive integer\", () => {",
              "    pm.expect(req.NoOfParcels).to.be.a(\"number\").and.be.above(0);",
              "    pm.expect(Number.isInteger(req.NoOfParcels)).to.be.true;",
              "});",
              "",
              "// ═══════════════════════════════════════════════════════════════",
              "//  NEGATIVE TEST CASES",
              "// ═══════════════════════════════════════════════════════════════",
              "",
              "// ───────────────────────────────────────────────────────────────",
              "//  SECTION J – HTTP Error Guards",
